{
  "name": "atomic-clock-sync",
  "version": "1.4.0",
  "description": "Sync Casio Multiband 6 watches with simulated time signals through your speakers. A JavaScript and Electron desktop app for macOS and Windows.",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.*",
    "test:desktop": "electron scripts/smoke.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --mac zip",
    "dist:win": "electron-builder --win portable --x64",
    "dist:linux": "electron-builder --linux AppImage",
    "bundle": "python3 scripts/bundle-releases.py"
  },
  "keywords": [
    "casio",
    "multiband6",
    "dcf77",
    "wwvb",
    "jjy",
    "msf",
    "bpc",
    "electron",
    "time-synchronization"
  ],
  "author": "Atomic Clock Sync",
  "license": "MIT",
  "type": "commonjs",
  "build": {
    "appId": "it.atomicclocksync.desktop",
    "productName": "Atomic Clock Sync",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "zip"
      ],
      "identity": "-",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.png",
      "artifactName": "${productName}-${version}-windows-${arch}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "assets/icon.png"
    },
    "toolsets": {
      "nsis": "1.2.1"
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  }
}
