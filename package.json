{
  "name": "atomic-clock-sync",
  "productName": "AtomicClockSync",
  "version": "1.11.0",
  "description": "Sync compatible Casio watches through Bluetooth or simulated Multiband 6 time signals. A JavaScript and Electron desktop app for macOS, Windows and Linux.",
  "homepage": "https://github.com/Gladiak/atomicClockSync",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "start:debug": "node scripts/debug.cjs",
    "build:icon": "node scripts/create-icon.cjs",
    "test": "node --test test/*.test.*",
    "build:bluetooth": "node scripts/build-bluetooth.cjs",
    "test:bluetooth": "electron scripts/bluetooth-smoke.cjs",
    "test:desktop": "electron scripts/smoke.cjs",
    "test:navigation": "electron scripts/navigation-smoke.cjs",
    "test:languages": "electron scripts/languages-smoke.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --mac zip",
    "dist:win": "electron-builder --win portable --x64",
    "dist:linux": "electron-builder --linux --x64",
    "dist:linux:docker": "bash scripts/build-linux-docker.sh",
    "checksums": "python3 scripts/release-checksums.py",
    "build:world": "node scripts/build-world-vendor.mjs",
    "test:world": "electron scripts/world-smoke.cjs",
    "build:iss": "node scripts/build-iss.mjs",
    "test:iss": "electron scripts/iss-smoke.cjs",
    "test:back-in-time": "electron scripts/back-in-time-smoke.cjs",
    "test:observatory": "electron scripts/observatory-smoke.cjs",
    "test:light-travel": "electron scripts/light-travel-smoke.cjs",
    "test:reception-lab": "electron scripts/reception-lab-smoke.cjs",
    "test:accuracy": "electron scripts/watch-accuracy-smoke.cjs",
    "test:guide": "electron scripts/guide-smoke.cjs",
    "capture:guide": "electron scripts/capture-manual.cjs"
  },
  "keywords": [
    "casio",
    "multiband6",
    "dcf77",
    "wwvb",
    "jjy",
    "msf",
    "bpc",
    "electron",
    "time-synchronization"
  ],
  "author": "Atomic Clock Sync",
  "license": "MIT",
  "type": "commonjs",
  "build": {
    "beforePack": "scripts/require-bluetooth.cjs",
    "appId": "it.atomicclocksync.desktop",
    "productName": "AtomicClockSync",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "extraResources": [{ "from": "build/bluetooth/darwin-${arch}/atomic-bluetooth", "to": "bluetooth/atomic-bluetooth" }],
      "extendInfo": { "NSBluetoothAlwaysUsageDescription": "AtomicClockSync uses Bluetooth to update the date and time on your Casio watch." },
      "category": "public.app-category.utilities",
      "target": [
        "zip"
      ],
      "identity": "-",
      "icon": "assets/icon.png"
    },
    "win": {
      "extraResources": [{ "from": "build/bluetooth/win32-${arch}/atomic-bluetooth", "to": "bluetooth/atomic-bluetooth" }],
      "target": [
        "portable"
      ],
      "icon": "assets/icon.png",
      "artifactName": "${productName}-${version}-windows-${arch}-portable.${ext}"
    },
    "linux": {
      "extraResources": [{ "from": "build/bluetooth/linux-${arch}/atomic-bluetooth", "to": "bluetooth/atomic-bluetooth" }],
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility",
      "icon": "assets/icon.png",
      "maintainer": "Atomic Clock Sync contributors",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "toolsets": {
      "nsis": "1.2.1",
      "appimage": "1.0.3"
    }
  },
  "devDependencies": {
    "astronomy-engine": "2.1.19",
    "d3-geo": "3.1.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "0.28.2",
    "satellite.js": "7.1.0",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  }
}
